rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCorpEmail() {
      return signedIn()
        && request.auth.token.email is string
        && (
          request.auth.token.email.matches('(?i).*@csgi\\.com$')
          || request.auth.token.email.matches('(?i).*@csg\\.com$')
        );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'wow-csg@csgi.com',
          'admin@csgi.com'
        ];
    }

    match /users/{uid} {
      allow read: if isCorpEmail();
      allow create: if isOwner(uid) && isCorpEmail();
      allow update: if (isOwner(uid) || isAdmin()) && isCorpEmail();
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isCorpEmail();
      allow create: if isCorpEmail()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isCorpEmail()
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isCorpEmail()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /postLikes/{likeId} {
      allow read: if isCorpEmail();
      allow create, delete: if isCorpEmail()
        && likeId.matches('.*_' + request.auth.uid + '$');
    }

    match /comments/{commentId} {
      allow read: if isCorpEmail();
      allow create: if isCorpEmail()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isCorpEmail()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /follows/{followId} {
      allow read: if isCorpEmail();
      allow create, delete: if isCorpEmail()
        && followId.matches(request.auth.uid + '_.*');
    }

    match /stories/{storyId} {
      // Expiry is enforced client-side; do not gate list queries on expiresAt
      // (Firestore denies queries when rules filter fields not present in the query).
      allow read: if isCorpEmail();
      allow create: if isCorpEmail()
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if isCorpEmail()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /notifications/{notifId} {
      allow read: if isCorpEmail()
        && resource.data.toUid == request.auth.uid;
      allow create: if isCorpEmail();
      allow update: if isCorpEmail()
        && resource.data.toUid == request.auth.uid;
      allow delete: if isCorpEmail()
        && (resource.data.toUid == request.auth.uid || isAdmin());
    }

    match /hashtags/{tag} {
      allow read: if isCorpEmail();
      allow write: if isCorpEmail();
    }

    match /postHashtags/{id} {
      allow read: if isCorpEmail();
      allow write: if isCorpEmail();
    }

    match /conversations/{convId} {
      allow read: if isCorpEmail()
        && request.auth.uid in resource.data.memberIds;
      allow create: if isCorpEmail()
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isCorpEmail()
        && request.auth.uid in resource.data.memberIds;
    }

    match /messages/{messageId} {
      allow read: if isCorpEmail();
      allow create: if isCorpEmail()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isCorpEmail()
        && (resource.data.senderId == request.auth.uid || isAdmin());
    }
  }
}
